// =============================================================================
// CONECTA MINEDEC (C2.2) — ETAPA 2: GOBIERNO PAP Y MOTOR HIBRIDO RBAC + ABAC (PDP)
// Normalizacion: BCNF Estricta con Aislamiento Multi-Aplicacion + Cache L2 PDP
// Alineado 1:1 con migrations/001..004 y modelo de Feature 004 (motor-pdp)
// =============================================================================

Project conecta_minedec_sso_etapa_2 {
  database_type: 'PostgreSQL'
  Note: '''
    # Etapa 2 — Gobierno de Aplicaciones (PAP) y Motor de Autorizacion RBAC + ABAC (PDP)
    Incluye:
    - **12 Tablas SQL en AlloyDB (Verde #2e7d32)**: Aplicaciones (`migrations/004` + `modo_sombra`), Administradores Globales y Delegados (`SUPERADMIN_SEGURIDAD`, `AUDITOR_GLOBAL`, `ADMIN_PROPIETARIO`, `OPERADOR_POLITICAS`, `AUDITOR_APP`), Catalogo de Rutas HTTP en 1FN con regla explicita `modo_evaluacion_permisos` (`ANY` / `ALL`), Permisos Atomicos, Roles con matriz CRUD (`puede_crear`, `puede_leer`, `puede_editar`, `puede_eliminar`), Perfiles, Grupos Logicos con AST JSON (`regla_cruce_abac_rbac`) y Asignaciones Nominales sin duplicados activos, con aislamiento multi-aplicacion en BCNF.
    - **2 Proyecciones Key-Value en Memorystore for Redis (Naranja #ef6c00)**: `redis_l2_pdp_app_bundle` y `redis_l2_pdp_authz_decision` (TTL <= 300 s, cero RUC, cero campos de latencia).
    - **3 Tablas de Referencia de Etapa 1 (Gris #78909c)**: `persona_identidad`, `cuenta_institucional` y `asignacion_contexto` (alineadas 1:1 con `migrations/001` y `003`).
  '''
}

// =============================================================================
// REFERENCIAS DE ETAPA 1 (ALINEADAS 1:1 CON MIGRATIONS/001 Y 003)
// Color: Gris Referencia (#78909c)
// =============================================================================

Table persona_identidad [headercolor: #78909c] {
  id_interno uuid [pk, not null, note: 'PK tecnica inmutable creada en Etapa 1 (migrations/001)']
  tipo_identificacion varchar(20) [not null, note: 'CHECK: CEDULA | PASAPORTE | CODIGO_MINEDEC']
  numero_identificacion varchar(64) [not null, unique]
  codigo_minedec_anterior varchar(64) [null, unique]
  nombre_completo varchar(250) [not null]
  fecha_nacimiento date [null]
  representante_legal_cedula varchar(10) [null]
  estado_persona varchar(32) [not null, note: 'CHECK: ACTIVA | PENDIENTE_IDENTIFICACION | PENDIENTE_CONCILIACION | RESTRINGIDA_ANOMALIA | BLOQUEADA_ANOMALIA | INACTIVA']

  Note: '[REFERENCIA ETAPA 1 — migrations/001] Raiz civil y demografica de Persona Natural. No almacena atributos de perfil; estos viven en cuenta_institucional y asignacion_contexto.'
}

Table cuenta_institucional [headercolor: #78909c] {
  cuenta_id uuid [pk, not null]
  id_interno uuid [not null, ref: > persona_identidad.id_interno]
  google_sub_id varchar(64) [not null, unique]
  email_principal varchar(254) [not null, unique]
  dominio varchar(120) [not null]
  org_unit_path varchar(512) [not null]
  tipo_usuario varchar(40) [null, note: 'CHECK: ESTUDIANTE | DOCENTE | ADMINISTRATIVO | EXTERNO | DOCENTE_ADMINISTRATIVO | CIUDADANO_EXTERNO']
  subtipo_usuario varchar(40) [null]
  cargo_funcion varchar(64) [null]
  grado_curso varchar(32) [null]
  nivel_academico_derivado varchar(32) [null]
  docente_multisede boolean [not null, default: false]
  fecha_inicio_vigencia date [null]
  fecha_fin_vigencia date [null]
  suspended_en_gws boolean [not null, default: false]
  estado_sincronizacion varchar(32) [not null, note: 'CHECK: SINCRONIZADA | REGISTRO_CALIENTE | SUSPENDIDA_GWS | ELIMINADA_GWS | VIGENCIA_VENCIDA | BLOQUEADA_ANOMALIA']

  Note: '[REFERENCIA ETAPA 1 — migrations/001] Cuenta de Google Workspace que porta los atributos RBAC/ABAC de perfil por subdominio poblacional.'
}

Table asignacion_contexto [headercolor: #78909c] {
  asignacion_id uuid [pk, not null]
  id_interno uuid [not null, ref: > persona_identidad.id_interno]
  cuenta_id uuid [null, ref: > cuenta_institucional.cuenta_id]
  es_sede_primaria boolean [not null, default: false]
  nivel_estructura varchar(40) [not null, default: 'INSTITUCION_EDUCATIVA']
  viceministerio varchar(40) [not null, default: 'NO_APLICA']
  codigo_zona varchar(4) [not null]
  codigo_distrito varchar(8) [null]
  codigo_circuito varchar(12) [null]
  codigo_amie varchar(8) [null]
  codigo_dependencia_admin varchar(160) [null]
  activo boolean [not null, default: true]

  Note: '[REFERENCIA ETAPA 1 — migrations/001] Asignaciones territoriales y multisede (1:N) que alimentan amie_titular, amies_asignados y jurisdiccion en el motor-pdp.'
}

// =============================================================================
// TABLAS SQL ALLOYDB — ETAPA 2: PAP Y MOTOR HIBRIDO RBAC + ABAC (3FN / Aislamiento Multi-App por FK Compuesta)
// Color: Verde Autorizacion (#2e7d32)
// =============================================================================

Table aplicacion [headercolor: #2e7d32] {
  aplicacion_id uuid [pk, default: `gen_random_uuid()`, note: 'Creada en migrations/004_sso_oidc_broker_schema.sql']
  codigo_unico varchar(64) [unique, not null, note: 'Slug institucional inmutable (ej. sso-academico)']
  nombre_visible varchar(160) [not null]
  descripcion text [null]
  patron_integracion varchar(32) [not null, note: 'CHECK: PATRON_1_SP_RP | PATRON_2_PEP_PERIMETRAL']
  nivel_adopcion_pep varchar(24) [null, note: 'CHECK: PROTEGIDA | INTEGRADA | NATIVA']
  host_publico varchar(255) [unique, not null, note: 'FQDN expuesto en Cloud Load Balancing / Apigee X']
  url_backend_interno varchar(512) [null]
  politica_ruta_defecto varchar(24) [not null, default: 'PROTEGIDA', note: 'CHECK: PUBLICA | AUTENTICADA | PROTEGIDA (Fail-close por defecto RF-AU-09)']
  modo_sombra boolean [not null, default: false, note: 'Añadida en migrations/005 (ALTER TABLE): activa Shadow Mode global en la aplicacion (con override opcional en ruta_catalogo)']
  viceministerio_dueno varchar(40) [not null, default: 'EDUCACION', note: 'CHECK: EDUCACION | DEPORTE | CULTURA']
  estado_ciclo_vida varchar(24) [not null, default: 'BORRADOR', note: 'CHECK: BORRADOR | PUBLICANDO | PUBLICADO | SUSPENDIDO | DESPUBLICADO']
  version_catalogo integer [not null, default: 1, note: 'CHECK: version_catalogo >= 1']
  creado_por uuid [not null, ref: > persona_identidad.id_interno]
  creado_en timestamptz [not null, default: `now()`]
  actualizado_en timestamptz [not null, default: `now()`]

  indexes {
    (estado_ciclo_vida) [name: 'idx_aplicacion_estado_ciclo_vida']
  }

  Note: '[ETAPA 2 — SQL ALLOYDB] Registro de activos tecnologicos protegidos por Conecta MINEDEC (creada en migrations/004 y extendida con modo_sombra y CHECK de viceministerio_dueno en migrations/005).'
}

Table administrador_aplicativo [headercolor: #2e7d32] {
  admin_app_id uuid [pk, default: `gen_random_uuid()`]
  aplicacion_id uuid [null, ref: > aplicacion.aplicacion_id, note: 'NULL para roles globales de consola (SUPERADMIN_SEGURIDAD, AUDITOR_GLOBAL); NOT NULL para delegacion acotada por aplicacion (ADMIN_PROPIETARIO, OPERADOR_POLITICAS, AUDITOR_APP)']
  id_interno uuid [not null, ref: > persona_identidad.id_interno]
  rol_consola varchar(32) [not null, default: 'ADMIN_PROPIETARIO', note: 'CHECK: SUPERADMIN_SEGURIDAD | AUDITOR_GLOBAL | ADMIN_PROPIETARIO | OPERADOR_POLITICAS | AUDITOR_APP. Constraint chk_admin_scope_coherente valida aplicacion_id IS NULL <-> rol global.']
  activo boolean [not null, default: true]
  asignado_por uuid [not null, ref: > persona_identidad.id_interno]
  creado_en timestamptz [not null, default: `now()`]
  actualizado_en timestamptz [not null, default: `now()`]

  indexes {
    (id_interno, rol_consola, aplicacion_id) [unique, name: 'uq_admin_consola_persona_ambito', note: 'UNIQUE NULLS NOT DISTINCT WHERE activo = true en PostgreSQL 16 (impide duplicar rol global o delegado)']
    (id_interno, activo) [name: 'idx_admin_app_persona_activo']
  }

  Note: '[ETAPA 2 — SQL ALLOYDB] Gobierno centralizado y delegado de la Consola Web (RF-GA-02). Modela los 3 roles oficiales: Superadministrador de Seguridad Informatica (global), Auditor (global o por app) y Administrador/Operador de Aplicativo (acotado a su aplicacion_id).'
}

Table ruta_catalogo [headercolor: #2e7d32] {
  ruta_id uuid [pk, default: `gen_random_uuid()`]
  aplicacion_id uuid [not null, ref: > aplicacion.aplicacion_id]
  patron_ruta varchar(512) [not null, note: 'Ruta normalizada sin .. ni %2F (ej. /api/v1/calificaciones/*)']
  metodo_http varchar(10) [not null, default: 'ALL', note: '1FN Estricta — CHECK: GET | POST | PUT | PATCH | DELETE | OPTIONS | HEAD | ALL']
  tipo_coincidencia varchar(16) [not null, note: 'CHECK: EXACTA (1) | PREFIJO (2) | EXTENSION (3)']
  nivel_acceso varchar(16) [not null, note: 'CHECK: PUBLICA | AUTENTICADA | PROTEGIDA']
  modo_evaluacion_permisos varchar(8) [not null, default: 'ANY', note: 'CHECK: ANY (OR logico: basta poseer al menos 1 permiso requerido) | ALL (AND logico: debe poseer todos los permisos requeridos en ruta_permiso_requerido)']
  modo_sombra boolean [not null, default: false, note: 'Override opcional de Shadow Mode por ruta individual (complementa aplicacion.modo_sombra)']
  orden_especificidad integer [not null, default: 100, note: 'Precedencia determinista: Exacta > Prefijo mas largo > Extension > Defecto']
  descripcion varchar(255) [null]
  activo boolean [not null, default: true]
  creado_en timestamptz [not null, default: `now()`]
  actualizado_en timestamptz [not null, default: `now()`]

  indexes {
    (aplicacion_id, ruta_id) [unique, name: 'uq_ruta_app_id_bcnf']
    (aplicacion_id, patron_ruta, metodo_http, tipo_coincidencia) [unique, name: 'uq_ruta_app_patron_metodo']
    (aplicacion_id, activo, orden_especificidad) [name: 'idx_ruta_evaluacion_pdp']
  }

  Note: '[ETAPA 2 — SQL ALLOYDB] Catalogo declarativo de rutas (1FN/3FN). Incluye modo_evaluacion_permisos (ANY vs ALL) y override opcional modo_sombra por ruta.'
}

Table permiso_atomico [headercolor: #2e7d32] {
  permiso_id uuid [pk, default: `gen_random_uuid()`]
  aplicacion_id uuid [not null, ref: > aplicacion.aplicacion_id]
  codigo_permiso varchar(100) [not null, note: 'Accion o recurso granular ej. CALIFICACIONES:REGISTRAR']
  nombre_visible varchar(160) [not null]
  descripcion text [null]
  activo boolean [not null, default: true]
  creado_en timestamptz [not null, default: `now()`]
  actualizado_en timestamptz [not null, default: `now()`]

  indexes {
    (aplicacion_id, permiso_id) [unique, name: 'uq_permiso_app_id_bcnf']
    (aplicacion_id, codigo_permiso) [unique, name: 'uq_permiso_app_codigo']
  }

  Note: '[ETAPA 2 — SQL ALLOYDB] Unidad minima de autorizacion (RF-AU-02). Incluye clave unica compuesta (aplicacion_id, permiso_id) para aislamiento multi-aplicacion por FK compuesta.'
}

Table ruta_permiso_requerido [headercolor: #2e7d32] {
  aplicacion_id uuid [not null, note: 'Aislamiento por FK compuesta: garantiza que la ruta y el permiso pertenezcan a la misma aplicacion']
  ruta_id uuid [not null]
  permiso_id uuid [not null]
  accion_crud_requerida varchar(16) [not null, default: 'CUALQUIERA', note: 'CHECK: CUALQUIERA | CREAR | LEER | EDITAR | ELIMINAR (exige que el permiso efectivo tenga habilitado el flag booleano correspondiente en rol_permiso)']
  creado_en timestamptz [not null, default: `now()`]

  indexes {
    (ruta_id, permiso_id) [pk, name: 'pk_ruta_permiso_requerido']
  }

  Note: '[ETAPA 2 — SQL ALLOYDB] Tabla asociativa con aislamiento por FK compuesta: vincula una ruta PROTEGIDA con los permisos atomicos requeridos de la misma aplicacion (evaluados bajo ANY o ALL segun ruta_catalogo.modo_evaluacion_permisos).'
}

Table rol [headercolor: #2e7d32] {
  rol_id uuid [pk, default: `gen_random_uuid()`]
  aplicacion_id uuid [not null, ref: > aplicacion.aplicacion_id]
  codigo_rol varchar(80) [not null, note: 'ej. DOCENTE_CALIFICADOR, ANALISTA_DISTRITAL']
  nombre_visible varchar(160) [not null]
  descripcion text [null]
  es_rol_sistema boolean [not null, default: false]
  activo boolean [not null, default: true]
  creado_en timestamptz [not null, default: `now()`]
  actualizado_en timestamptz [not null, default: `now()`]

  indexes {
    (aplicacion_id, rol_id) [unique, name: 'uq_rol_app_id_bcnf']
    (aplicacion_id, codigo_rol) [unique, name: 'uq_rol_app_codigo']
  }

  Note: '[ETAPA 2 — SQL ALLOYDB] Roles de negocio por aplicacion (RF-AU-01). Posee clave compuesta (aplicacion_id, rol_id) para aislamiento por FK compuesta.'
}

Table rol_permiso [headercolor: #2e7d32] {
  aplicacion_id uuid [not null, note: 'Aislamiento por FK compuesta: impide cruzar un rol de App A con un permiso de App B']
  rol_id uuid [not null]
  permiso_id uuid [not null]
  puede_crear boolean [not null, default: false, note: 'Capacidad CRUD aditiva: se consolida con OR logico (bool_or) al unir multiples roles/perfiles/grupos logicos']
  puede_leer boolean [not null, default: true, note: 'Capacidad CRUD aditiva: se consolida con OR logico (bool_or)']
  puede_editar boolean [not null, default: false, note: 'Capacidad CRUD aditiva: se consolida con OR logico (bool_or)']
  puede_eliminar boolean [not null, default: false, note: 'Capacidad CRUD aditiva: se consolida con OR logico (bool_or). CHECK chk_rol_permiso_al_menos_un_crud: (puede_crear OR puede_leer OR puede_editar OR puede_eliminar)']
  creado_en timestamptz [not null, default: `now()`]
  actualizado_en timestamptz [not null, default: `now()`]

  indexes {
    (rol_id, permiso_id) [pk, name: 'pk_rol_permiso']
  }

  Note: '[ETAPA 2 — SQL ALLOYDB] Relacion M:N con aislamiento por FK compuesta entre Rol y Permiso Atomico dentro de la misma aplicacion, incluyendo los 4 indicadores granulares CRUD y CHECK que exige al menos una bandera CRUD en true.'
}

Table perfil [headercolor: #2e7d32] {
  perfil_id uuid [pk, default: `gen_random_uuid()`]
  aplicacion_id uuid [not null, ref: > aplicacion.aplicacion_id]
  codigo_perfil varchar(80) [not null]
  nombre_visible varchar(160) [not null]
  descripcion text [null]
  activo boolean [not null, default: true]
  creado_en timestamptz [not null, default: `now()`]
  actualizado_en timestamptz [not null, default: `now()`]

  indexes {
    (aplicacion_id, perfil_id) [unique, name: 'uq_perfil_app_id_bcnf']
    (aplicacion_id, codigo_perfil) [unique, name: 'uq_perfil_app_codigo']
  }

  Note: '[ETAPA 2 — SQL ALLOYDB] Agrupacion reutilizable de roles dentro de una aplicacion (RF-AUZ-04), asignable tanto a Grupos Logicos (grupo_logico_perfil) como directamente a usuarios (usuario_rol_aplicacion.perfil_id).'
}

Table perfil_rol [headercolor: #2e7d32] {
  aplicacion_id uuid [not null, note: 'Aislamiento por FK compuesta: impide cruzar un perfil de App A con un rol de App B']
  perfil_id uuid [not null]
  rol_id uuid [not null]
  creado_en timestamptz [not null, default: `now()`]

  indexes {
    (perfil_id, rol_id) [pk, name: 'pk_perfil_rol']
  }

  Note: '[ETAPA 2 — SQL ALLOYDB] Relacion M:N con aislamiento por FK compuesta entre Perfil y Rol de la misma aplicacion.'
}

Table grupo_logico [headercolor: #2e7d32] {
  grupo_logico_id uuid [pk, default: `gen_random_uuid()`]
  aplicacion_id uuid [not null, ref: > aplicacion.aplicacion_id]
  codigo_grupo varchar(80) [not null, note: 'ej. GL_DOCENTES_AULA_ACTIVOS']
  nombre_visible varchar(160) [not null]
  descripcion text [null]
  regla_cruce_abac_rbac jsonb [not null, note: 'AST JSON tipado (Zod) que cruza Tripleta RBAC x Predicados ABAC sobre los atributos de cuenta_institucional y asignacion_contexto']
  prioridad_evaluacion integer [not null, default: 100]
  activo boolean [not null, default: true]
  creado_por uuid [not null, ref: > persona_identidad.id_interno]
  creado_en timestamptz [not null, default: `now()`]
  actualizado_en timestamptz [not null, default: `now()`]

  indexes {
    (aplicacion_id, grupo_logico_id) [unique, name: 'uq_grupo_app_id_bcnf']
    (aplicacion_id, codigo_grupo) [unique, name: 'uq_grupo_app_codigo']
  }

  Note: '[ETAPA 2 — SQL ALLOYDB] Motor declarativo RBAC x ABAC (RF-AUZ-06). Cuando un usuario satisface multiples grupos logicos, el motor-pdp aplica union aditiva de roles, perfiles y permisos CRUD.'
}

Table grupo_logico_rol [headercolor: #2e7d32] {
  aplicacion_id uuid [not null, note: 'Aislamiento por FK compuesta: garantiza que el grupo logico y el rol pertenezcan a la misma aplicacion']
  grupo_logico_id uuid [not null]
  rol_id uuid [not null]
  creado_en timestamptz [not null, default: `now()`]

  indexes {
    (grupo_logico_id, rol_id) [pk, name: 'pk_grupo_logico_rol']
  }

  Note: '[ETAPA 2 — SQL ALLOYDB] Roles otorgados automaticamente cuando el expediente de una cuenta satisface la regla RBAC x ABAC del grupo logico.'
}

Table grupo_logico_perfil [headercolor: #2e7d32] {
  aplicacion_id uuid [not null, note: 'Aislamiento por FK compuesta: garantiza que el grupo logico y el perfil pertenezcan a la misma aplicacion']
  grupo_logico_id uuid [not null]
  perfil_id uuid [not null]
  creado_en timestamptz [not null, default: `now()`]

  indexes {
    (grupo_logico_id, perfil_id) [pk, name: 'pk_grupo_logico_perfil']
  }

  Note: '[ETAPA 2 — SQL ALLOYDB] Perfiles reutilizables (RF-AUZ-04) otorgados automaticamente cuando una cuenta satisface la regla RBAC x ABAC del grupo logico (se expanden a sus roles activos mediante perfil_rol).'
}

Table usuario_rol_aplicacion [headercolor: #2e7d32] {
  asignacion_rol_id uuid [pk, default: `gen_random_uuid()`]
  id_interno uuid [not null, ref: > persona_identidad.id_interno]
  cuenta_id uuid [null, note: 'Opcional: acota la asignacion a una cuenta especifica con FK compuesta (cuenta_id, id_interno) -> cuenta_institucional(cuenta_id, id_interno)']
  aplicacion_id uuid [not null]
  rol_id uuid [null, note: 'Rol individual asignado (mutuamente excluyente con perfil_id: CHECK (rol_id IS NOT NULL) <> (perfil_id IS NOT NULL))']
  perfil_id uuid [null, note: 'Perfil reutilizable asignado (RF-AUZ-04, mutuamente excluyente con rol_id)']
  codigo_zona_acotado varchar(4) [null, note: 'Scoping territorial opcional para esta asignacion puntual']
  codigo_distrito_acotado varchar(8) [null]
  codigo_circuito_acotado varchar(12) [null]
  codigo_amie_acotado varchar(8) [null, note: 'FK a catalogo_territorio_sede.codigo_amie']
  fecha_inicio_vigencia date [not null, default: `CURRENT_DATE`]
  fecha_fin_vigencia date [null, note: 'CHECK: fecha_fin_vigencia IS NULL OR fecha_fin_vigencia >= fecha_inicio_vigencia']
  activo boolean [not null, default: true]
  asignado_por uuid [not null, ref: > persona_identidad.id_interno]
  motivo_asignacion varchar(255) [null]
  creado_en timestamptz [not null, default: `now()`]
  actualizado_en timestamptz [not null, default: `now()`]

  indexes {
    (id_interno, aplicacion_id, activo) [name: 'idx_usuario_rol_app_activo']
    (id_interno, cuenta_id, aplicacion_id, rol_id, perfil_id, codigo_zona_acotado, codigo_distrito_acotado, codigo_circuito_acotado, codigo_amie_acotado) [unique, name: 'uq_usuario_rol_ambito_activo', note: 'UNIQUE NULLS NOT DISTINCT WHERE activo = true (impide asignaciones activas duplicadas de la misma persona/cuenta, rol/perfil y ambito)']
  }

  Note: '[ETAPA 2 — SQL ALLOYDB] Asignacion directa nominal de roles o perfiles especificos del aplicativo (RF-AUZ-10, RF-AUZ-04) con FK compuesta (cuenta_id, id_interno), acotamiento territorial completo (zona/distrito/circuito/AMIE), vigencia validada (fin >= inicio) e invalidacion Pub/Sub por id_interno.'
}

// =============================================================================
// CACHE L2 REDIS — ETAPA 2 (PROYECCIONES KEY-VALUE EN MEMORIA)
// =============================================================================

Table redis_l2_pdp_app_bundle [headercolor: #ef6c00] {
  redis_key varchar(160) [pk, not null, note: 'pdp:app:{aplicacion_id}:policy_bundle | pdp:app:host:{host_publico}']
  aplicacion_id uuid [not null]
  version_catalogo integer [not null]
  modo_sombra boolean [not null, default: false]
  rutas_ordenadas_json jsonb [not null, note: 'Rutas pre-ordenadas por especificidad (EXACTA > PREFIJO > EXTENSION) con modo_evaluacion_permisos (ANY | ALL) y override modo_sombra por ruta']
  grupos_logicos_ast_json jsonb [not null, note: 'Reglas RBAC x ABAC (AST) precompiladas + mapa de roles, perfiles expandidos y permisos atomicos con flags CRUD']
  ttl_segundos integer [not null, default: 300]

  Note: '[ETAPA 2 — MEMORYSTORE FOR REDIS 7.x] Estructura Key-Value en RAM (No es tabla SQL). Bundle de politicas por aplicacion con TTL <= 300 s.'
}

Table redis_l2_pdp_authz_decision [headercolor: #ef6c00] {
  redis_key varchar(320) [pk, not null, note: 'pdp:authz:{id_interno}:{cuenta_id}:{aplicacion_id}:{version_catalogo}:{hash_ruta_metodo}']
  id_interno uuid [not null]
  cuenta_id uuid [not null, note: 'Aisla decisiones por cuenta institucional (resuelve coexistencia Docente + Estudiante de una misma persona)']
  aplicacion_id uuid [not null]
  roles_efectivos_json jsonb [not null, note: 'Union aditiva de roles por Grupo Logico (roles + perfiles) + usuario_rol_aplicacion']
  permisos_efectivos_json jsonb [not null, note: 'Lista deduplicada de codigos de permiso atomico otorgados']
  permisos_crud_json jsonb [not null, note: 'Mapa de capacidades CRUD efectivas por permiso consolidado con bool_or {puede_crear, puede_leer, puede_editar, puede_eliminar}']
  scoping_territorial_json jsonb [not null, note: '{amie_titular, amies_asignados[], codigo_zona, codigo_distrito, codigo_circuito, nivel_jurisdiccion, codigo_jurisdiccion} — Exclusivo personas naturales (cero RUC)']
  ttl_segundos integer [not null, default: 300, note: 'TTL <= min(300s, segundos_hasta_fin_vigencia). Se purga en < 5s via Pub/Sub por id_interno ante cambios en usuario_rol_aplicacion o asignacion_contexto']

  Note: '[ETAPA 2 — MEMORYSTORE FOR REDIS 7.x] Estructura Key-Value en RAM (No es tabla SQL). Decision precalculada por (id_interno, cuenta_id) para POST /api/v1/access/evaluation (DA-12).'
}

// =============================================================================
// RELACIONES DE LA ETAPA 2 (INCLUYENDO LLAVES COMPUESTAS DE AISLAMIENTO)
// =============================================================================

Ref: ruta_permiso_requerido.(aplicacion_id, ruta_id) > ruta_catalogo.(aplicacion_id, ruta_id)
Ref: ruta_permiso_requerido.(aplicacion_id, permiso_id) > permiso_atomico.(aplicacion_id, permiso_id)
Ref: rol_permiso.(aplicacion_id, rol_id) > rol.(aplicacion_id, rol_id)
Ref: rol_permiso.(aplicacion_id, permiso_id) > permiso_atomico.(aplicacion_id, permiso_id)
Ref: perfil_rol.(aplicacion_id, perfil_id) > perfil.(aplicacion_id, perfil_id)
Ref: perfil_rol.(aplicacion_id, rol_id) > rol.(aplicacion_id, rol_id)
Ref: grupo_logico_rol.(aplicacion_id, grupo_logico_id) > grupo_logico.(aplicacion_id, grupo_logico_id)
Ref: grupo_logico_rol.(aplicacion_id, rol_id) > rol.(aplicacion_id, rol_id)
Ref: grupo_logico_perfil.(aplicacion_id, grupo_logico_id) > grupo_logico.(aplicacion_id, grupo_logico_id)
Ref: grupo_logico_perfil.(aplicacion_id, perfil_id) > perfil.(aplicacion_id, perfil_id)
Ref: usuario_rol_aplicacion.(aplicacion_id, rol_id) > rol.(aplicacion_id, rol_id)
Ref: usuario_rol_aplicacion.(aplicacion_id, perfil_id) > perfil.(aplicacion_id, perfil_id)
Ref: usuario_rol_aplicacion.cuenta_id > cuenta_institucional.cuenta_id

Ref: redis_l2_pdp_app_bundle.aplicacion_id - aplicacion.aplicacion_id
Ref: redis_l2_pdp_authz_decision.id_interno > persona_identidad.id_interno
Ref: redis_l2_pdp_authz_decision.cuenta_id > cuenta_institucional.cuenta_id
Ref: redis_l2_pdp_authz_decision.aplicacion_id > aplicacion.aplicacion_id

TableGroup "Referencia_Etapa_1" {
  persona_identidad
  cuenta_institucional
  asignacion_contexto
}

TableGroup "Etapa_2_PAP_Autorizacion_RBAC_ABAC" {
  aplicacion
  administrador_aplicativo
  ruta_catalogo
  permiso_atomico
  ruta_permiso_requerido
  rol
  rol_permiso
  perfil
  perfil_rol
  grupo_logico
  grupo_logico_rol
  grupo_logico_perfil
  usuario_rol_aplicacion
}

TableGroup "Etapa_2_Cache_L2_Memorystore_Redis" {
  redis_l2_pdp_app_bundle
  redis_l2_pdp_authz_decision
}
