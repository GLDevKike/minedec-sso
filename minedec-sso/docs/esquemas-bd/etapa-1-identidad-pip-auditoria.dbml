// =============================================================================
// Conecta MINEDEC (Subcomponente C2.2) — Modelo Relacional 3FN Puro (Etapa 1)
// Feature: 001-modelo-identidades-perfil
// Motor:   AlloyDB for PostgreSQL 16 + Memorystore for Redis (Caché L2, TTL <= 300s)
// Alineado 1:1 con migrations/001_init_pip_identity_schema.sql y repositorios pg-*
// =============================================================================

Project conecta_minedec_pip_etapa1 {
  database_type: 'PostgreSQL'
  Note: 'Modelo relacional en 3FN pura del Punto de Información de Políticas (PIP), Catálogos Parametrizables (D-03 / FO-DNTIC-20), Bandeja de Anomalías y Auditoría Inmutable SHA-256. Exclusivo para Personas Naturales (Constitución v2.7.0 Principio X.2) y Tenant Único de Google Workspace (D-21).'
}

// -----------------------------------------------------------------------------
// 1. Subdominios Institucionales del Único Tenant de Google Workspace (D-21)
// -----------------------------------------------------------------------------
Table dominio_institucional {
  dominio varchar(120) [pk, note: 'Dominio o subdominio institucional en minúsculas (ej. educacion.gob.ec, docentes.educacion.gob.ec, estudiante.edu.ec).']
  google_customer_id varchar(64) [not null, note: 'ID inmutable del único tenant de Google Workspace del Ministerio (ej. C01MINEDEC01).']
  tipo_poblacion varchar(40) [not null, note: 'CHECK: ESTUDIANTE | DOCENTE | ADMINISTRATIVO | MIXTO']
  es_subdominio boolean [not null, default: false, note: 'true para subdominios dedicados por población dentro del mismo tenant.']
  activo boolean [not null, default: true]
  creado_en timestamptz [not null, default: `now()`]
  actualizado_en timestamptz [not null, default: `now()`]

  indexes {
    (google_customer_id, activo) [name: 'idx_dominio_customer_activo']
  }
}

// -----------------------------------------------------------------------------
// 2. Catálogo Parametrizable Jerárquico MINEDEC_Perfil (D-03 + FO-DNTIC-20)
// -----------------------------------------------------------------------------
Table catalogo_atributo_minedec {
  catalogo_id uuid [pk, default: `gen_random_uuid()`]
  categoria_atributo varchar(40) [not null, note: 'CHECK: TIPO_IDENTIFICACION | TIPO_USUARIO | SUBTIPO_USUARIO | CARGO_FUNCION | GRADO_CURSO | NIVEL_ACADEMICO | VICEMINISTERIO | NIVEL_ESTRUCTURA | REGIMEN_ESCOLAR | MODALIDAD_EDUCATIVA | JORNADA']
  codigo_valor varchar(64) [not null, note: 'Código canónico en mayúsculas (ej. DOCENTE_CONTRATO, 8EGB, EDUCACION_SUPERIOR).']
  codigo_padre varchar(64) [null, note: 'Código jerárquico padre (ej. DOCENTE para SUBTIPO_USUARIO).']
  etiqueta_visible varchar(160) [not null]
  nivel_academico_derivado varchar(32) [null, note: 'Exclusivo para GRADO_CURSO: código de NIVEL_ACADEMICO que se deriva determinísticamente.']
  requiere_vigencia_temporal boolean [not null, default: false, note: 'true cuando el subtipo exige fecha_inicio_vigencia y fecha_fin_vigencia.']
  metadatos_regla jsonb [not null, default: '{}', note: 'Reglas adicionales y diccionario sinonimosOrigen para homologar fuentes FO-DNTIC-20.']
  activo boolean [not null, default: true]
  creado_en timestamptz [not null, default: `now()`]
  actualizado_en timestamptz [not null, default: `now()`]

  indexes {
    (categoria_atributo, codigo_valor) [unique, name: 'uq_catalogo_categoria_codigo']
    (categoria_atributo, activo) [name: 'idx_catalogo_categoria_activo']
  }
}

// -----------------------------------------------------------------------------
// 3. Maestro Normalizado 3FN de Sedes Educativas (AMIE) y Territorio
// -----------------------------------------------------------------------------
Table catalogo_territorio_sede {
  codigo_amie varchar(8) [pk, note: 'Código oficial AMIE validado por regex ^(0[1-9]|1[0-9]|2[0-4]|90)[A-Z][0-9]{5}$']
  nombre_institucion varchar(200) [not null]
  codigo_zona varchar(4) [not null, note: 'Código de zona 01..09 o 90 con preservación de cero inicial.']
  codigo_distrito varchar(8) [null, note: 'Anulable para sedes especiales FO-DNTIC-20 sin distrito asignado.']
  codigo_circuito varchar(12) [null, note: 'Anulable para sedes especiales FO-DNTIC-20 sin circuito asignado.']
  provincia_dpa varchar(2) [null, note: 'Código DPA INEC provincia (01..24, 90).']
  canton_dpa varchar(4) [null, note: 'Código DPA INEC cantón.']
  parroquia_dpa varchar(6) [null, note: 'Código DPA INEC parroquia.']
  regimen_escolar varchar(24) [not null, default: 'SIERRA_AMAZONIA', note: 'CHECK: COSTA_GALAPAGOS | SIERRA_AMAZONIA | NO_APLICA']
  sostenimiento varchar(30) [null, note: 'CHECK: FISCAL | FISCOMISIONAL | MUNICIPAL | PARTICULAR']
  modalidad_educativa varchar(30) [null, default: 'PRESENCIAL', note: 'CHECK: PRESENCIAL | SEMIPRESENCIAL | A_DISTANCIA | VIRTUAL | NO_APLICA']
  jornada varchar(24) [null, default: 'MATUTINA', note: 'CHECK: MATUTINA | VESPERTINA | NOCTURNA | INTENSIVA | NO_APLICA']
  activo boolean [not null, default: true]
  creado_en timestamptz [not null, default: `now()`]
  actualizado_en timestamptz [not null, default: `now()`]

  indexes {
    (codigo_zona, codigo_distrito, codigo_circuito) [name: 'idx_territorio_jerarquia']
  }
}

// -----------------------------------------------------------------------------
// 4. Nivel 1 (3FN Puro): Raíz Civil y Demográfica de Persona Natural
// -----------------------------------------------------------------------------
Table persona_identidad {
  id_interno uuid [pk, default: `gen_random_uuid()`, note: 'PK técnica inmutable UUID v4. Protege FKs y auditoria_evento ante transición CODIGO_MINEDEC -> CEDULA.']
  tipo_identificacion varchar(20) [not null, note: 'CHECK: CEDULA | PASAPORTE | CODIGO_MINEDEC (Exclusivo personas naturales - Constitución X.2). Cuando estado_persona = PENDIENTE_IDENTIFICACION se asigna CODIGO_MINEDEC.']
  numero_identificacion varchar(64) [not null, unique, note: 'VARCHAR con preservación de cero inicial (01..09). Cuando estado_persona = PENDIENTE_IDENTIFICACION almacena PROVISIONAL-{google_sub_id}. Protegido por trigger trg_enforce_cedula_immutability cuando tipo_identificacion = CEDULA.']
  codigo_minedec_anterior varchar(64) [null, unique, note: 'Almacena el CODIGO_MINEDEC previo tras la única transición unidireccional permitida a CEDULA.']
  nombre_completo varchar(250) [not null]
  fecha_nacimiento date [null]
  representante_legal_cedula varchar(10) [null, note: 'Cédula válida Módulo 10 del representante legal cuando el estudiante es menor de edad (< 18 años).']
  estado_persona varchar(32) [not null, default: 'ACTIVA', note: 'CHECK: ACTIVA | PENDIENTE_IDENTIFICACION | PENDIENTE_CONCILIACION | RESTRINGIDA_ANOMALIA | BLOQUEADA_ANOMALIA | INACTIVA']
  creado_en timestamptz [not null, default: `now()`]
  actualizado_en timestamptz [not null, default: `now()`]

  indexes {
    (tipo_identificacion, numero_identificacion) [unique, name: 'uq_persona_tipo_numero_id']
    (numero_identificacion) [unique, name: 'uq_persona_numero_identificacion', note: 'Unicidad global intencional en migrations/001 para detección unívoca de COLISION_IDENTIFICADOR']
    (estado_persona) [name: 'idx_persona_estado']
    (codigo_minedec_anterior) [name: 'idx_persona_codigo_anterior']
  }
}

// -----------------------------------------------------------------------------
// 5. Nivel 2 (3FN con Atributo Derivado Materializado): Cuenta Institucional y Perfil Poblacional por Subdominio
// -----------------------------------------------------------------------------
Table cuenta_institucional {
  cuenta_id uuid [pk, default: `gen_random_uuid()`]
  id_interno uuid [not null, ref: > persona_identidad.id_interno]
  google_sub_id varchar(64) [not null, unique, note: 'Identificador inmutable de Google Workspace (sub / id).']
  email_principal varchar(254) [not null, unique, note: 'Correo institucional en minúsculas con índice funcional uq_cuenta_email_lower.']
  dominio varchar(120) [not null, ref: > dominio_institucional.dominio]
  org_unit_path varchar(512) [not null, default: '/']
  given_name varchar(120) [null]
  family_name varchar(120) [null]
  tipo_usuario varchar(40) [null, note: 'CHECK: ESTUDIANTE | DOCENTE | ADMINISTRATIVO | EXTERNO | DOCENTE_ADMINISTRATIVO | CIUDADANO_EXTERNO']
  subtipo_usuario varchar(40) [null, note: 'Validado contra catalogo_atributo_minedec con jerarquía codigo_padre = tipo_usuario.']
  cargo_funcion varchar(64) [null]
  grado_curso varchar(32) [null]
  nivel_academico_derivado varchar(32) [null, note: 'Atributo derivado materializado determinísticamente desde grado_curso como única fuente maestra para indexación ABAC rápida.']
  docente_multisede boolean [not null, default: false]
  fecha_inicio_vigencia date [null]
  fecha_fin_vigencia date [null, note: 'CHECK: fecha_fin_vigencia >= fecha_inicio_vigencia. Vencimiento dispara fail-close VIGENCIA_VENCIDA.']
  suspended_en_gws boolean [not null, default: false]
  estado_sincronizacion varchar(32) [not null, default: 'SINCRONIZADA', note: 'CHECK: SINCRONIZADA | REGISTRO_CALIENTE | SUSPENDIDA_GWS | ELIMINADA_GWS | VIGENCIA_VENCIDA | BLOQUEADA_ANOMALIA']
  origen_ultima_sincronizacion varchar(40) [null, note: 'CHECK: EVENTO_AUDIT_LOG | BARRIDO_DELTA_2MIN | CONCILIACION_BATCH | CONCILIACION_DIARIA | REGISTRO_CALIENTE_PRIORITARIO']
  hash_payload_gws char(64) [null, note: 'Hash SHA-256 canónico del payload de Google Workspace para evitar escrituras redundantes (FR-010, añadido con ALTER TABLE en migrations/003).']
  ultima_sincronizacion_en timestamptz [not null, default: `now()`]
  creado_en timestamptz [not null, default: `now()`]
  actualizado_en timestamptz [not null, default: `now()`]

  indexes {
    (id_interno) [name: 'idx_cuenta_id_interno']
    (cuenta_id, id_interno) [unique, name: 'uq_cuenta_id_persona_compuesto', note: 'Añadido en migrations/005 para habilitar FK compuesta (cuenta_id, id_interno) y garantizar que cuenta_id pertenezca a ese id_interno']
    (dominio, estado_sincronizacion) [name: 'idx_cuenta_dominio_estado']
    (tipo_usuario, subtipo_usuario, cargo_funcion) [name: 'idx_cuenta_rbac_tripleta']
  }
}

// -----------------------------------------------------------------------------
// 6. Asignación de Contexto Territorial, Organizacional y Multisede (3FN)
// -----------------------------------------------------------------------------
Table asignacion_contexto {
  asignacion_id uuid [pk, default: `gen_random_uuid()`]
  id_interno uuid [not null, ref: > persona_identidad.id_interno]
  cuenta_id uuid [null, ref: > cuenta_institucional.cuenta_id, note: 'FK compuesta (cuenta_id, id_interno) -> cuenta_institucional(cuenta_id, id_interno) en migrations/005 cuando cuenta_id IS NOT NULL']
  origen_datos varchar(24) [not null, default: 'PAP_DELEGADO', note: 'CHECK: GWS_PRIMARIO | PAP_DELEGADO']
  es_sede_primaria boolean [not null, default: false]
  nivel_estructura varchar(40) [not null, default: 'INSTITUCION_EDUCATIVA', note: 'CHECK: PLANTA_CENTRAL | ZONA | DISTRITO | CIRCUITO | INSTITUCION_EDUCATIVA']
  viceministerio varchar(40) [not null, default: 'NO_APLICA', note: 'CHECK: EDUCACION | DEPORTE | CULTURA | GESTION_EDUCATIVA | NO_APLICA']
  codigo_zona varchar(4) [not null, note: 'Preserva cero inicial (01..09, 10..24, 90). Cuando codigo_amie IS NOT NULL, se valida por trigger contra la jerarquía de catalogo_territorio_sede.']
  codigo_distrito varchar(8) [null, note: 'Cuando codigo_amie IS NOT NULL, debe coincidir con el distrito padre del AMIE en catalogo_territorio_sede.']
  codigo_circuito varchar(12) [null, note: 'Cuando codigo_amie IS NOT NULL, debe coincidir con el circuito padre del AMIE en catalogo_territorio_sede.']
  codigo_amie varchar(8) [null, ref: > catalogo_territorio_sede.codigo_amie, note: 'FK normalizada en 3FN hacia catalogo_territorio_sede.']
  codigo_dependencia_admin varchar(160) [null]
  regimen_escolar varchar(24) [not null, default: 'NO_APLICA', note: 'CHECK: COSTA_GALAPAGOS | SIERRA_AMAZONIA | NO_APLICA']
  modalidad_educativa varchar(30) [not null, default: 'NO_APLICA', note: 'CHECK: PRESENCIAL | SEMIPRESENCIAL | A_DISTANCIA | VIRTUAL | NO_APLICA']
  jornada varchar(24) [not null, default: 'NO_APLICA', note: 'CHECK: MATUTINA | VESPERTINA | NOCTURNA | INTENSIVA | NO_APLICA']
  activo boolean [not null, default: true]
  asignado_por_identificacion varchar(64) [null, note: 'En Etapa 1 es VARCHAR(64) porque admite identificadores de actores batch/GWS (ej. SYSTEM_GWS_SYNC) además de cédulas de operadores.']
  motivo_asignacion text [null]
  creado_en timestamptz [not null, default: `now()`]
  actualizado_en timestamptz [not null, default: `now()`]

  indexes {
    (id_interno, activo) [name: 'idx_contexto_id_interno_activo']
    (codigo_amie, activo) [name: 'idx_contexto_amie_activo']
    (codigo_zona, codigo_distrito, codigo_circuito) [name: 'idx_contexto_zona_distrito_circuito']
  }
}

// -----------------------------------------------------------------------------
// 7. Bandeja de Anomalías de Identidad (Bloqueo Graduado y Trazabilidad)
// -----------------------------------------------------------------------------
Table anomalia_identidad {
  anomalia_id uuid [pk, default: `gen_random_uuid()`]
  anomalia_anterior_id uuid [null, ref: > anomalia_identidad.anomalia_id, note: 'Encadena recurrencias cuando una misma cuenta vuelve a presentar la misma causal tras haberse resuelto.']
  id_interno uuid [null, ref: > persona_identidad.id_interno]
  cuenta_id uuid [null, ref: > cuenta_institucional.cuenta_id]
  google_sub_id varchar(64) [not null]
  email_principal varchar(254) [not null]
  dominio varchar(120) [not null]
  codigo_causal varchar(40) [not null, note: 'CHECK: SIN_IDENTIFICACION_VALIDA | COLISION_IDENTIFICADOR | VIGENCIA_INVALIDA | ATRIBUTO_OBLIGATORIO_FALTANTE | FORMATO_AMIE_INVALIDO']
  efecto_acceso varchar(20) [not null, note: 'CHECK: BLOQUEANTE | RESTRINGIDA']
  estado_anomalia varchar(24) [not null, default: 'ABIERTA', note: 'CHECK: ABIERTA | EN_REVISION | LISTA_PARA_CERRAR | RESUELTA | DESCARTADA']
  origen_resolucion varchar(32) [null, note: 'CHECK: AUTO_SINCRONIZACION | MANUAL_ADMIN']
  resuelta_por_identificacion varchar(64) [null]
  motivo_resolucion text [null]
  valor_anterior jsonb [null]
  valor_nuevo jsonb [null]
  detalle_tecnico text [not null]
  detectada_en timestamptz [not null, default: `now()`]
  resuelta_en timestamptz [null]

  indexes {
    (estado_anomalia, codigo_causal, dominio, detectada_en) [name: 'idx_anomalia_bandeja_estado']
    (google_sub_id, codigo_causal, estado_anomalia) [name: 'idx_anomalia_google_sub_causal']
    (id_interno) [name: 'idx_anomalia_id_interno']
  }
}

// -----------------------------------------------------------------------------
// 8. Auditoría Inmutable Append-Only con Cadena SHA-256 (Constitución XV)
// -----------------------------------------------------------------------------
Table auditoria_evento {
  evento_id uuid [pk, default: `gen_random_uuid()`]
  tipo_evento varchar(64) [not null, note: 'CHECK: IDENTIDAD_SINCRONIZADA | IDENTIDAD_CREADA | IDENTIDAD_ACTUALIZADA | IDENTIDAD_SUSPENDIDA | IDENTIDAD_ELIMINADA | PERSONA_DESACTIVADA | TRANSICION_CODIGO_A_CEDULA | INTENTO_MUTACION_CEDULA_RECHAZADO | REGISTRO_CALIENTE_CREADO | REGISTRO_CALIENTE_PROVISIONAL | REGISTRO_CALIENTE_UNIFICADO | REGISTRO_CALIENTE_FUSIONADO | REGISTRO_CALIENTE_PROMOVIDO | ANOMALIA_DETECTADA | ANOMALIA_ABIERTA | ANOMALIA_RESUELTA | ANOMALIA_AUTO_RESUELTA | ASIGNACION_CONTEXTO_CREADA | ASIGNACION_CONTEXTO_MODIFICADA | ASIGNACION_CONTEXTO_DESACTIVADA | CACHE_INVALIDADO | CATALOGO_ACTUALIZADO | CONCILIACION_PARTICION_COMPLETADA | CONCILIACION_PARTICION_RECLAMADA | EVENTO_DLQ_REGISTRADO | EVENTO_DLQ_REPROCESADO | OIDC_AUTHORIZE_INICIADO | OIDC_FEDERACION_GOOGLE_EXITOSA | OIDC_ID_TOKEN_EMITIDO | OIDC_REGISTRO_CALIENTE_PENDIENTE_BLOQUEADO | OIDC_RECHAZO_SEGURIDAD | OIDC_SLO_EJECUTADO | OIDC_SESION_REVOCADA_PUBSUB | OIDC_JWKS_ROTADO | OIDC_JWKS_REVOCADO_EMERGENCIA']
  actor_id_interno uuid [null, ref: > persona_identidad.id_interno, note: 'Referencia al actor (NULL si es job de sistema o evaluación no autenticada).']
  actor_identificacion varchar(64) [not null]
  sujeto_identificacion varchar(64) [null]
  correo_afectado varchar(254) [null]
  origen_canal varchar(32) [not null, note: 'CHECK: PIP_INGEST | LOGIN_JIT | PDP_MOTOR | PAP_ADMIN | SYNC_INCREMENTAL | SYNC_BATCH_JOB | SINCRONIZADOR_GWS | SSO_OIDC_BROKER']
  entidad_afectada varchar(64) [not null]
  registro_afectado_id varchar(128) [not null]
  valores_anteriores jsonb [null]
  valores_nuevos jsonb [null]
  hash_evento_anterior_sha256 char(64) [not null, note: 'Hash SHA-256 del evento inmediato anterior (serializado con pg_advisory_xact_lock).']
  hash_evento_sha256 char(64) [not null, unique, note: 'Hash SHA-256 actual protegido por trigger trg_enforce_auditoria_append_only.']
  fecha_evento timestamptz [not null, default: `now()`]

  indexes {
    (sujeto_identificacion, fecha_evento) [name: 'idx_auditoria_sujeto_fecha']
    (actor_identificacion, fecha_evento) [name: 'idx_auditoria_actor_fecha']
    (tipo_evento, fecha_evento) [name: 'idx_auditoria_tipo_fecha']
  }
}

// -----------------------------------------------------------------------------
// 9. Checkpoint de Conciliación Particionada (Feature 002)
// -----------------------------------------------------------------------------
Table checkpoint_conciliacion {
  checkpoint_id uuid [pk, default: `gen_random_uuid()`]
  dominio varchar(120) [not null, ref: > dominio_institucional.dominio]
  org_unit_path varchar(512) [not null, default: '/']
  tipo_proceso varchar(32) [not null, note: 'CHECK: BARRIDO_DELTA_2MIN | CONCILIACION_DIARIA | CONCILIACION_MASIVA']
  next_page_token text [null]
  cuentas_procesadas integer [not null, default: 0]
  cuentas_actualizadas integer [not null, default: 0]
  cuentas_omitidas_hash integer [not null, default: 0]
  cuentas_baja_detectadas integer [not null, default: 0]
  anomalias_abiertas integer [not null, default: 0]
  estado_ejecucion varchar(24) [not null, default: 'PENDIENTE', note: 'CHECK: PENDIENTE | EN_PROGRESO | COMPLETADA | PAUSADA_CUOTA | FALLIDA']
  worker_instancia_id varchar(128) [null]
  lock_advisory_key bigint [not null]
  heartbeat_en timestamptz [not null, default: `now()`]
  iniciado_en timestamptz [not null, default: `now()`]
  completado_en timestamptz [null]
  ultimo_error_codigo varchar(64) [null]
  diagnostico_operativo text [null]
  creado_en timestamptz [not null, default: `now()`]
  actualizado_en timestamptz [not null, default: `now()`]

  indexes {
    (dominio, org_unit_path, tipo_proceso) [unique, name: 'uq_checkpoint_particion']
    (estado_ejecucion, heartbeat_en) [name: 'idx_checkpoint_estado_heartbeat']
    (dominio, tipo_proceso) [name: 'idx_checkpoint_dominio_proceso']
  }
}

// -----------------------------------------------------------------------------
// 10. Evento de Sincronización Procesado (Idempotencia y Orden Monotónico)
// -----------------------------------------------------------------------------
Table evento_sincronizacion_procesado {
  id_evento_externo varchar(128) [pk]
  google_sub_id varchar(64) [not null]
  email_principal varchar(254) [null]
  tipo_evento varchar(48) [not null, note: 'CHECK: CREATE_USER | CHANGE_USER_CUSTOM_FIELDS | SUSPEND_USER | UNSUSPEND_USER | DELETE_USER | UNDELETE_USER | CHANGE_ORG_UNIT | HOT_REGISTRATION_RECONCILE | DELTA_SWEEP_UPDATE']
  timestamp_evento_gws timestamptz [not null]
  origen_canal varchar(32) [not null, note: 'CHECK: PUBSUB_AUDIT_LOG | CLOUD_SCHEDULER_DELTA | CLOUD_TASKS_PRIORITY | DLQ_REPLAY']
  modo_despacho varchar(24) [not null, note: 'CHECK: DIRECT_EXTRACT | FETCH_BY_SUB']
  resultado varchar(32) [not null, note: 'CHECK: PROCESADO | OMITIDO_HASH_IDENTICO | DESCARTADO_OBSOLETO | IGNORADO_IDEMPOTENTE']
  hash_payload_gws char(64) [null]
  procesado_en timestamptz [not null, default: `now()`]

  indexes {
    (google_sub_id, timestamp_evento_gws) [name: 'idx_evento_sync_sub_timestamp']
    (procesado_en) [name: 'idx_evento_sync_procesado_en']
  }
}

// -----------------------------------------------------------------------------
// 11. Registro de Fallo de Sincronización / DLQ Persistente (Feature 002)
// -----------------------------------------------------------------------------
Table registro_fallo_sincronizacion {
  dlq_id uuid [pk, default: `gen_random_uuid()`]
  id_evento_externo varchar(128) [not null, unique]
  origen_canal varchar(32) [not null, note: 'CHECK: PUBSUB_AUDIT_LOG | CLOUD_TASKS_PRIORITY | BARRIDO_DELTA_2MIN | CONCILIACION_MASIVA']
  google_sub_id varchar(64) [null]
  email_principal varchar(254) [null]
  dominio varchar(120) [null]
  tipo_evento varchar(48) [not null]
  payload_original jsonb [not null]
  intentos_realizados integer [not null, default: 5]
  codigo_error varchar(64) [not null]
  detalle_error_tecnico text [not null]
  diagnostico_lenguaje_natural text [not null]
  accion_recomendada text [not null]
  estado_dlq varchar(32) [not null, default: 'PENDIENTE_REVISION', note: 'CHECK: PENDIENTE_REVISION | EN_REPROCESO | EN_REPROCESAMIENTO (alias retrocompatible en 003) | RESUELTO_REPROCESADO | RESUELTO_POR_OBSOLESCENCIA | DESCARTADO_MANUAL']
  resuelto_por_identificacion varchar(64) [null]
  motivo_resolucion text [null]
  creado_en timestamptz [not null, default: `now()`]
  actualizado_en timestamptz [not null, default: `now()`]
  resuelto_en timestamptz [null]

  indexes {
    (estado_dlq, creado_en) [name: 'idx_dlq_estado_creado']
    (google_sub_id) [name: 'idx_dlq_google_sub']
  }
}
