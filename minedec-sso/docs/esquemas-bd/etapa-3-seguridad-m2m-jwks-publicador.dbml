// =============================================================================
// CONECTA MINEDEC (C2.2) — ETAPA 3: SEGURIDAD OIDC, M2M, ROTACION JWKS Y PUBLICADOR INFRA
// Sincronizado 1:1 con migrations/004_sso_oidc_broker_schema.sql y Feature 004 (motor-pdp)
// Incluye: Clientes OIDC (DA-11), Credenciales OAuth2 M2M (SHA-256), JWKS RS256 (<= 90d),
//          Infra Manager y Estado Efimero OIDC en Memorystore for Redis
// =============================================================================

Project conecta_minedec_sso_etapa_3 {
  database_type: 'PostgreSQL'
  Note: '''
    # Etapa 3 — Seguridad Criptografica OIDC (DA-11), M2M, Rotacion JWKS RS256 y Publicador de Aplicaciones
    Incluye:
    - **5 Tablas SQL en AlloyDB (Purpura #6a1b9a)**:
      1. `cliente_oidc`: Clientes OIDC por aplicacion (`DA-11`) con indice unico `uq_cliente_oidc_aplicacion` (`1:1` con `aplicacion_id`).
      2. `cliente_oidc_redirect_uri`: URLs de retorno OIDC normalizadas en 1FN/3FN.
      3. `credencial_m2m`: Clientes OAuth2 `client_credentials` (`POST /api/v1/oauth/token`) con `tipo_cliente` (`APLICACION_PATRON_1` | `PEP_PATRON_2`), `scopes_permitidos` (`pdp:evaluate` por defecto conforme a `DA-12`), hashes SHA-256 y rotacion dual `<= 90 dias`.
      4. `llave_jwks_rotacion`: Metadatos de llaves asimetricas RS256 segregadas por `servicio_emisor` (`SSO_OIDC` | `MOTOR_PDP`).
      5. `publicacion_infra`: Historial de despliegues Terraform en Google Cloud Infrastructure Manager ejecutados por el Cloud Run Job Publicador con `pg_try_advisory_lock`.
    - **3 Proyecciones Memorystore for Redis de `sso-oidc` (Naranja #ef6c00)**:
      `redis_l2_oidc_session`, `redis_l2_oidc_auth_code` y `redis_l2_oidc_session_index`.
    - **2 Tablas de Referencia de Etapas 1 y 2 (Gris #78909c)**: `persona_identidad` y `aplicacion`.
  '''
}

// =============================================================================
// REFERENCIAS DE ETAPAS 1 Y 2 (SINCRONIZADAS CON MIGRATIONS 001 Y 004)
// Color: Gris Referencia (#78909c)
// =============================================================================

Table persona_identidad [headercolor: #78909c] {
  id_interno uuid [pk, not null, default: `gen_random_uuid()`, note: 'PK creada en Etapa 1 (migrations/001)']
  tipo_identificacion varchar(20) [not null, note: 'CHECK: CEDULA | PASAPORTE | CODIGO_MINEDEC']
  numero_identificacion varchar(64) [not null]
  nombre_completo varchar(250) [not null]
  estado_persona varchar(32) [not null, note: 'CHECK: ACTIVA | PENDIENTE_IDENTIFICACION | PENDIENTE_CONCILIACION | RESTRINGIDA_ANOMALIA | BLOQUEADA_ANOMALIA | INACTIVA']

  Note: '[REFERENCIA ETAPA 1] Persona natural que solicita o audita despliegues de infraestructura.'
}

Table aplicacion [headercolor: #78909c] {
  aplicacion_id uuid [pk, not null, default: `gen_random_uuid()`, note: 'PK creada en migrations/004']
  codigo_unico varchar(64) [unique, not null]
  nombre_visible varchar(160) [not null]
  patron_integracion varchar(32) [not null, note: 'CHECK: PATRON_1_SP_RP | PATRON_2_PEP_PERIMETRAL']
  host_publico varchar(255) [unique, not null]
  modo_sombra boolean [not null, default: false, note: 'Agregado en migrations/005 (Feature 004)']
  estado_ciclo_vida varchar(24) [not null]
  version_catalogo integer [not null]

  Note: '[REFERENCIA ETAPA 2] Activo tecnologico al que pertenecen los clientes OIDC, credenciales M2M y publicaciones de Terraform.'
}

// =============================================================================
// TABLAS SQL ALLOYDB — ETAPA 3: SEGURIDAD OIDC (DA-11), M2M, JWKS Y PUBLICADOR INFRA
// Color: Purpura Seguridad (#6a1b9a)
// =============================================================================

Table cliente_oidc [headercolor: #6a1b9a] {
  cliente_oidc_id uuid [pk, not null, default: `gen_random_uuid()`]
  aplicacion_id uuid [not null, note: 'FK a aplicacion.aplicacion_id (1 cliente OIDC exclusivo por aplicacion registrada — uq_cliente_oidc_aplicacion, DA-11)']
  oidc_client_id varchar(128) [unique, not null, note: 'Identificador OIDC para Authorization Code + PKCE S256 contra sso-oidc']
  secreto_activo_hash char(64) [null, note: 'SHA-256 hex del client_secret OIDC (NULL si metodo_autenticacion_token = none)']
  secreto_anterior_hash char(64) [null, note: 'SHA-256 hex para ventana de gracia dual sin downtime']
  gracia_hasta timestamptz [null]
  expira_rotacion_en timestamptz [null, note: 'Rotacion <= 90 dias para clientes confidenciales']
  metodo_autenticacion_token varchar(32) [not null, default: 'client_secret_basic', note: 'CHECK: client_secret_basic | client_secret_post | none']
  estado_cliente varchar(24) [not null, default: 'ACTIVO', note: 'CHECK: ACTIVO | EN_ROTACION_GRACIA | REVOCADO']
  creado_en timestamptz [not null, default: `now()`]
  actualizado_en timestamptz [not null, default: `now()`]

  indexes {
    (aplicacion_id) [unique, name: 'uq_cliente_oidc_aplicacion']
    (aplicacion_id, estado_cliente) [name: 'idx_cliente_oidc_aplicacion_estado']
  }

  Note: '''
    [ETAPA 3 — DA-11] Clientes OIDC registrados en `sso-oidc` (`oidc-provider`).
    - Emite ID Tokens RS256 con `aud = oidc_client_id` exclusivo por aplicacion (`uq_cliente_oidc_aplicacion`), tanto para aplicaciones Patron 1 como para aplicaciones Patron 2 mediadas por el PEP Perimetral.
  '''
}

Table cliente_oidc_redirect_uri [headercolor: #6a1b9a] {
  redirect_uri_id uuid [pk, not null, default: `gen_random_uuid()`]
  cliente_oidc_id uuid [not null, note: 'FK a cliente_oidc.cliente_oidc_id ON DELETE CASCADE']
  tipo_uri varchar(24) [not null, default: 'LOGIN_CALLBACK', note: 'CHECK: LOGIN_CALLBACK | POST_LOGOUT | BACKCHANNEL_LOGOUT']
  uri varchar(512) [not null, note: '1FN Estricta: URL HTTPS exacta autorizada (o localhost en dev, sin comodines)']
  activo boolean [not null, default: true]
  creado_en timestamptz [not null, default: `now()`]

  indexes {
    (cliente_oidc_id, tipo_uri, uri) [unique, name: 'uq_cliente_oidc_tipo_uri']
    (cliente_oidc_id, tipo_uri, activo) [name: 'idx_cliente_oidc_redirect_lookup']
  }

  Note: '[ETAPA 3 — DA-11] Normalizacion 1FN/3FN de las URLs de retorno (redirect_uris y post_logout_redirect_uris) por cliente OIDC en AlloyDB, sin limite de 100 URIs de GCP.'
}

Table credencial_m2m [headercolor: #6a1b9a] {
  credencial_id uuid [pk, not null, default: `gen_random_uuid()`]
  aplicacion_id uuid [null, note: 'FK a aplicacion.aplicacion_id (NOT NULL si tipo_cliente = APLICACION_PATRON_1; NULL si tipo_cliente = PEP_PATRON_2 transversal)']
  tipo_cliente varchar(24) [not null, default: 'APLICACION_PATRON_1', note: 'CHECK: APLICACION_PATRON_1 | PEP_PATRON_2']
  client_id varchar(128) [unique, not null, note: 'Identificador OAuth2 client_credentials']
  secreto_activo_hash char(64) [not null, note: 'SHA-256 hex (prohibido guardar secreto en texto plano)']
  secreto_anterior_hash char(64) [null, note: 'SHA-256 hex para ventana de gracia dual sin downtime']
  gracia_hasta timestamptz [null]
  expira_rotacion_en timestamptz [not null, note: 'Politica constitucional: rotacion obligatoria <= 90 dias']
  scopes_permitidos varchar(255) [not null, default: 'pdp:evaluate', note: 'Lista separada por espacios segun RFC 6749 (DA-12: pdp:evaluate)']
  estado_credencial varchar(24) [not null, default: 'ACTIVA', note: 'CHECK: ACTIVA | EN_ROTACION_GRACIA | REVOCADA']
  creado_en timestamptz [not null, default: `now()`]
  actualizado_en timestamptz [not null, default: `now()`]

  indexes {
    (aplicacion_id) [unique, name: 'uq_credencial_m2m_aplicacion', note: 'WHERE aplicacion_id IS NOT NULL']
    (estado_credencial) [name: 'idx_credencial_m2m_estado']
  }

  Note: '''
    [ETAPA 3 — SQL ALLOYDB] Credenciales M2M (`POST /api/v1/oauth/token`) con hashes SHA-256 y rotacion dual <= 90 dias (Constitucion IX):
    - `tipo_cliente = 'APLICACION_PATRON_1'`: `aplicacion_id IS NOT NULL`; el JWT M2M emitido solo autoriza evaluar su propio `aplicacion_codigo` (`AUTHZ_M2M_CROSS_APP_FORBIDDEN` si intenta evaluar otra).
    - `tipo_cliente = 'PEP_PATRON_2'`: `aplicacion_id IS NULL`; credencial de plataforma del PEP Perimetral autorizada a evaluar cualquier aplicacion con `patron_integracion = 'PATRON_2_PEP_PERIMETRAL'`.
  '''
}

Table llave_jwks_rotacion [headercolor: #6a1b9a] {
  kid varchar(64) [pk, not null, note: 'Key ID publicado en /jwks (sso-oidc) o /.well-known/jwks.json (motor-pdp)']
  servicio_emisor varchar(24) [not null, default: 'SSO_OIDC', note: 'CHECK: SSO_OIDC | MOTOR_PDP (segregacion criptografica por emisor)']
  algoritmo varchar(16) [not null, default: 'RS256', note: 'CHECK: RS256']
  secret_manager_version varchar(255) [not null, note: 'Referencia en Google Secret Manager (cero llaves privadas en BD)']
  public_jwk_json jsonb [not null, note: 'Clave publica JWK RS256 para verificacion de id_token (SSO_OIDC), X-Minedec-Assertion y JWT M2M (MOTOR_PDP)']
  estado_llave varchar(24) [not null, note: 'CHECK: ACTIVA_FIRMA | GRACIA_VERIFICACION | RETIRADA | REVOCADA']
  activada_en timestamptz [not null, default: `now()`]
  expira_rotacion_en timestamptz [not null, note: 'CHECK: expira_rotacion_en <= activada_en + INTERVAL 90 days']
  retirada_en timestamptz [null]

  indexes {
    (servicio_emisor) [unique, name: 'uq_llave_jwks_activa_por_emisor', note: 'WHERE estado_llave = ACTIVA_FIRMA']
    (servicio_emisor, estado_llave) [name: 'idx_llave_jwks_emisor_estado']
  }

  Note: '[ETAPA 3 — SQL ALLOYDB] Metadatos de llaves asimetricas RS256 segregadas por servicio_emisor (SSO_OIDC vs MOTOR_PDP) con ventana de gracia dual (<= 90d) y revocacion de emergencia. Las llaves privadas residen exclusivamente en Google Secret Manager.'
}

Table publicacion_infra [headercolor: #6a1b9a] {
  publicacion_id uuid [pk, not null, default: `gen_random_uuid()`]
  aplicacion_id uuid [not null, note: 'FK a aplicacion.aplicacion_id']
  version_catalogo integer [not null]
  estado_despliegue varchar(32) [not null, note: 'CHECK: EN_COLA | EJECUTANDO_TERRAFORM | PUBLICADO | FALLIDO | ROLLBACK']
  infra_manager_deployment_id varchar(255) [null, note: 'Deployment ID en Google Cloud Infrastructure Manager']
  snapshot_tfvars jsonb [not null, note: 'Variables declarativas inyectadas al blueprint Terraform (sin secretos)']
  resumen_error text [null]
  solicitada_por uuid [not null, note: 'FK a persona_identidad.id_interno (Superadmin o Admin de Aplicativo)']
  iniciada_en timestamptz [not null, default: `now()`]
  finalizada_en timestamptz [null]

  Note: '[ETAPA 3 — SQL ALLOYDB] Historial de despliegues del Publicador de Aplicaciones (Spec 008), serializado con pg_try_advisory_lock en AlloyDB.'
}

// =============================================================================
// CACHE L2 MEMORYSTORE FOR REDIS — SESION CENTRAL Y CODIGOS EFIMEROS DE SSO-OIDC (SPEC 003)
// Color: Naranja Cache (#ef6c00)
// =============================================================================

Table redis_l2_oidc_session [headercolor: #ef6c00] {
  redis_key varchar(255) [pk, not null, note: 'Patron: minedec:oidc:session:{sessionId} + testigo separado minedec:oidc:reval:{sessionId}']
  cuenta_id uuid [not null, note: 'Referencia logica a cuenta_institucional.cuenta_id']
  id_interno uuid [not null, note: 'Referencia logica a persona_identidad.id_interno']
  email_principal varchar(254) [not null]
  google_sub_id varchar(64) [not null, note: 'Alineado con cuenta_institucional.google_sub_id VARCHAR(64)']
  participating_client_ids jsonb [not null, note: 'Lista de oidc_client_id participantes en la sesion SSO para Single Logout']
  last_pip_validated_at timestamptz [not null, note: 'Revalidacion obligatoria contra PIP cada <= 300 s']
  ttl_seconds integer [not null, default: 28800, note: 'Duracion maxima de la sesion SSO central (8 horas / 28800 s)']
  reval_ttl_seconds integer [not null, default: 300, note: 'TTL duro <= 300 s de la clave testigo minedec:oidc:reval:{sessionId} que fuerza revalidacion contra PIP (RF-GI-06, PI-07)']

  Note: '[ETAPA 3 — REDIS L2 SSO-OIDC] Sesion central OIDC (`minedec:oidc:session:{sessionId}`, 8 h) gobernada por la marca testigo de revalidacion (`minedec:oidc:reval:{sessionId}`, TTL <= 300 s) y purgada inmediatamente via Pub/Sub.'
}

Table redis_l2_oidc_auth_code [headercolor: #ef6c00] {
  redis_key varchar(255) [pk, not null, note: 'Patron: minedec:oidc:adapter:AuthorizationCode:{codeId}']
  session_id varchar(128) [not null, note: 'Vinculo a minedec:oidc:session:{sessionId}']
  oidc_client_id varchar(128) [not null]
  code_challenge varchar(128) [not null, note: 'PKCE S256 obligatorio']
  code_challenge_method varchar(16) [not null, default: 'S256']
  redirect_uri varchar(512) [not null]
  consumed_at timestamptz [null, note: 'Single-use estricto: reuso detecta replay y revoca la sesion central']
  ttl_seconds integer [not null, default: 60, note: 'Maximo duro <= 60 s']

  Note: '[ETAPA 3 — REDIS L2 SSO-OIDC] Codigos de autorizacion OIDC de un solo uso con PKCE S256 y deteccion de replay.'
}

Table redis_l2_oidc_session_index [headercolor: #ef6c00] {
  redis_key varchar(255) [pk, not null, note: 'Patron: minedec:oidc:account_sessions:{cuentaId} | minedec:oidc:person_sessions:{idInterno}']
  id_interno uuid [not null, note: 'Referencia logica a persona_identidad.id_interno']
  session_ids_json jsonb [not null, note: 'Lista de sessionId activos para purga atomica ante baja o suspension']
  ttl_seconds integer [not null, default: 300]

  Note: '[ETAPA 3 — REDIS L2 SSO-OIDC] Indices invertidos de sesiones por cuenta y por persona para revocacion inmediata via Pub/Sub.'
}

// =============================================================================
// RELACIONES DE LA ETAPA 3
// =============================================================================

Ref: cliente_oidc.aplicacion_id > aplicacion.aplicacion_id
Ref: cliente_oidc_redirect_uri.cliente_oidc_id > cliente_oidc.cliente_oidc_id
Ref: credencial_m2m.aplicacion_id > aplicacion.aplicacion_id
Ref: publicacion_infra.aplicacion_id > aplicacion.aplicacion_id
Ref: publicacion_infra.solicitada_por > persona_identidad.id_interno
Ref: redis_l2_oidc_session.id_interno > persona_identidad.id_interno
Ref: redis_l2_oidc_session_index.id_interno > persona_identidad.id_interno

TableGroup "Referencias_Etapas_1_y_2" {
  persona_identidad
  aplicacion
}

TableGroup "Etapa_3_Seguridad_OIDC_M2M_JWKS_e_Infra" {
  cliente_oidc
  cliente_oidc_redirect_uri
  credencial_m2m
  llave_jwks_rotacion
  publicacion_infra
}

TableGroup "Etapa_3_Cache_L2_Memorystore_Redis_SSO_OIDC" {
  redis_l2_oidc_session
  redis_l2_oidc_auth_code
  redis_l2_oidc_session_index
}
