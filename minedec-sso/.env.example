# =============================================================================
# Conecta MINEDEC (Subcomponente C2.2) — Variables de Entorno de Ejemplo
# CERO SECRETOS REALES EN CÓDIGO (Constitución IX: 100% en Google Secret Manager en GCP)
# =============================================================================

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# AlloyDB for PostgreSQL 16 (Local Dev: PostgreSQL 16)
DATABASE_URL=postgresql://minedec_pip_app:local_dev_only_change_me@localhost:5432/conecta_minedec_pip
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Memorystore for Redis L2 (TTL duro <= 300 s — RF-AU-09 / Constitución IV)
REDIS_URL=redis://localhost:6379
REDIS_MAX_TTL_SECONDS=300

# Tenant Único de Google Workspace (D-01 / D-21 / RF-GI-01)
GWS_SINGLE_TENANT_CUSTOMER_ID=C01MINEDEC01

# Mensajería GCP (Cloud Pub/Sub y Cloud Tasks)
GCP_PROJECT_ID=minedec-sso-pdp-core
GCP_LOCATION=us-central1
PUBSUB_CACHE_INVALIDATION_TOPIC=conecta-cache-invalidation
CLOUD_TASKS_PRIORITY_SYNC_QUEUE=conecta-pip-priority-sync-queue
SYNC_WORKER_INTERNAL_URL=https://sync-internal.conecta.educacion.gob.ec/internal/v1/sync/priority-account

# Verificación JWT Interno de Servicio (OIDC / IAP)
INTERNAL_JWT_ISSUER=https://conecta.educacion.gob.ec
INTERNAL_JWT_AUDIENCE=pip-internal.conecta.educacion.gob.ec
