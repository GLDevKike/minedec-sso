{
  "name": "@minedec/shared",
  "version": "1.0.0",
  "description": "Paquete transversal @minedec/shared para Conecta MINEDEC (C2.2) — Dominio identitario, validación Zod, PostgreSQL parametrizado, Redis L2, JWKS RS256 y observabilidad OpenTelemetry",
  "private": false,
  "publishConfig": {
    "@minedec:registry": "https://git.sitimapa.co/api/v4/projects/${CI_PROJECT_ID}/packages/npm/"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^4.9.0",
    "@google-cloud/secret-manager": "^5.6.0",
    "@google-cloud/tasks": "^5.5.0",
    "googleapis": "^144.0.0",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "pg": "^8.13.3",
    "pg-format": "^1.0.4",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "eslint": "^9.20.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.24.1"
  }
}
